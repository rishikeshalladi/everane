    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/tasks": "^6.3.0",
    "cors": "^2.8.5",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^5.1.1",
    "luxon": "^3.4.4",
    "nodemailer": "^6.9.7",
    "twilio": "^5.3.0",
    "web-push": "^3.6.7"
  },
  "private": true
}

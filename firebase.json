{
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint"
    ],
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "target": "main",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "**/*.md",
      "**/*.txt",
      "**/*.log",
      "test.html",
      "sampleaddmedication.html",
      "samplecalendar.html",
      "samplehome.html",
      "stats_mobile_fixed.html",
      "add-medication-voice.html"
    ]
  }
}
